{"openapi":"3.1.0","info":{"title":"MDServer","description":"Decoupled MT5 REST API for MarketDash","version":"1.0.0"},"paths":{"/marketserver/api/recent/":{"get":{"tags":["Market Data"],"summary":"Recent Price Action","description":"Retrieve the most recent OHLCV price action data for a single asset.\n\nArgs:\n    symbol (str): The target trading asset (e.g., 'EURUSD').\n    timeframe (str): The chart resolution (e.g., 'H1', 'M15').\n    count (int): The number of recent candles to fetch.\n    \nReturns:\n    PriceActionResponse: A structured payload containing parsed OHLCV dictionaries.\n    \nRaises:\n    HTTPException: 400 if the timeframe is invalid, 404 if no data exists.","operationId":"recent_price_action_marketserver_api_recent__get","security":[{"APIKeyHeader":[]}],"parameters":[{"name":"symbol","in":"query","required":true,"schema":{"type":"string","description":"Target symbol (e.g., EURUSD)","title":"Symbol"},"description":"Target symbol (e.g., EURUSD)"},{"name":"timeframe","in":"query","required":true,"schema":{"type":"string","description":"Chart timeframe (e.g., H1, D1)","title":"Timeframe"},"description":"Chart timeframe (e.g., H1, D1)"},{"name":"count","in":"query","required":false,"schema":{"type":"integer","description":"Number of candles to retrieve","default":100,"title":"Count"},"description":"Number of candles to retrieve"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PriceActionResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/marketserver/api/ticks/recent/":{"get":{"tags":["Market Data"],"summary":"Recent Ticks","description":"Retrieve the most recent Level 1 tick data (Bid/Ask).\n\nFetches raw, unaggregated price changes. Useful for order flow analysis \nor building custom lower-timeframe charts.","operationId":"recent_ticks_marketserver_api_ticks_recent__get","security":[{"APIKeyHeader":[]}],"parameters":[{"name":"symbol","in":"query","required":true,"schema":{"type":"string","description":"Target symbol (e.g., EURUSD)","title":"Symbol"},"description":"Target symbol (e.g., EURUSD)"},{"name":"count","in":"query","required":false,"schema":{"type":"integer","maximum":5000,"description":"Number of ticks to retrieve (max 5000)","default":100,"title":"Count"},"description":"Number of ticks to retrieve (max 5000)"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TickDataResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/marketserver/api/book/":{"get":{"tags":["Market Data"],"summary":"Order Book","description":"Retrieve a snapshot of the Level 2 Depth of Market (Order Book).\n\nCFD and Forex brokers often restrict Level 2 DOM data. This endpoint traps \nthe MT5 subscription failure and degrades gracefully to a 404 Not Found \nrather than crashing the server.","operationId":"order_book_marketserver_api_book__get","security":[{"APIKeyHeader":[]}],"parameters":[{"name":"symbol","in":"query","required":true,"schema":{"type":"string","description":"Target symbol (e.g., EURUSD)","title":"Symbol"},"description":"Target symbol (e.g., EURUSD)"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrderBookResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/marketserver/api/historical/":{"get":{"tags":["Market Data"],"summary":"Historical Price Range","description":"Retrieve historical OHLC data bounded by a strict UTC date range.\n\nNote on timezones: The frontend requests exact UTC boundaries. This route \nshifts those UTC datetimes into the broker's local naive timezone before \nquerying MT5, ensuring the returned dataset strictly matches the requested window.","operationId":"historical_price_range_marketserver_api_historical__get","security":[{"APIKeyHeader":[]}],"parameters":[{"name":"symbol","in":"query","required":true,"schema":{"type":"string","title":"Symbol"}},{"name":"timeframe","in":"query","required":true,"schema":{"type":"string","title":"Timeframe"}},{"name":"start_date","in":"query","required":true,"schema":{"type":"string","title":"Start Date"}},{"name":"end_date","in":"query","required":true,"schema":{"type":"string","title":"End Date"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PriceActionResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/marketserver/api/recent/bulk/":{"get":{"tags":["Market Data"],"summary":"Bulk Recent Price Action","description":"Retrieve OHLC candles concurrently for multiple symbols and timeframes.\n\nNote: To prevent the MT5 terminal from freezing while aggregating deep \nhistorical data, queries for Weekly (W1) and Monthly (MN1) timeframes \nare strictly clamped to 5 periods.","operationId":"bulk_recent_price_action_marketserver_api_recent_bulk__get","security":[{"APIKeyHeader":[]}],"parameters":[{"name":"symbols","in":"query","required":true,"schema":{"type":"string","title":"Symbols"}},{"name":"timeframes","in":"query","required":false,"schema":{"type":"string","default":"H1,H4,D1,W1,MN1","title":"Timeframes"}},{"name":"count","in":"query","required":false,"schema":{"type":"integer","default":80,"title":"Count"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BulkPriceActionResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/marketserver/api/movers/":{"get":{"tags":["Market Data"],"summary":"Market Movers","description":"Fetch the most recent daily (D1) open and close prices to calculate market movers.\nIf no specific symbols are passed, it scans all broker-provided assets.","operationId":"market_movers_marketserver_api_movers__get","security":[{"APIKeyHeader":[]}],"parameters":[{"name":"symbols","in":"query","required":false,"schema":{"type":"string","title":"Symbols"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MarketMoversResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/marketserver/api/trade/positions/":{"get":{"tags":["Trade Execution"],"summary":"Open Positions","description":"Retrieve all currently open positions in the market.\n\nOptionally filters by a specific symbol. The underlying engine automatically \nenriches the raw MT5 data with real-time nominal valuations and margin \nrequirements before returning it.","operationId":"open_positions_marketserver_api_trade_positions__get","security":[{"APIKeyHeader":[]}],"parameters":[{"name":"symbol","in":"query","required":false,"schema":{"type":"string","description":"Optional symbol filter","title":"Symbol"},"description":"Optional symbol filter"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OpenPositionsResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/marketserver/api/trade/orders/":{"get":{"tags":["Trade Execution"],"summary":"Active Orders","description":"Retrieve all currently active pending orders.\n\nReturns resting limit and stop orders that have not yet been triggered \nor filled by the live market. Can be optionally filtered by symbol.","operationId":"active_orders_marketserver_api_trade_orders__get","security":[{"APIKeyHeader":[]}],"parameters":[{"name":"symbol","in":"query","required":false,"schema":{"type":"string","description":"Optional symbol filter","title":"Symbol"},"description":"Optional symbol filter"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ActiveOrdersResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/marketserver/api/trade/simulate/":{"post":{"tags":["Trade Execution"],"summary":"Simulate Trade Endpoint","description":"Calculate required margin and expected monetary profit before execution.\n\nLeverages MT5's internal calculator to evaluate risk using the broker's \ncurrent leverage and contract specifications without exposing capital.\n\nArgs:\n    request (SimulateTradeRequest): The theoretical trade parameters.\n    \nReturns:\n    TradeSimulationResponse: Margins and expected profits in the account's base currency.","operationId":"simulate_trade_endpoint_marketserver_api_trade_simulate__post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SimulateTradeRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TradeSimulationResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/marketserver/api/trade/execute/":{"post":{"tags":["Trade Execution"],"summary":"Execute Trade","description":"Executes a market or pending order.\n\nOptional parameters like target_price, stop_loss, and take_profit default \nto 0.0 at the schema level if omitted by the client.","operationId":"execute_trade_marketserver_api_trade_execute__post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ExecuteTradeRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TradeExecutionResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/marketserver/api/trade/close/":{"post":{"tags":["Trade Execution"],"summary":"Close Position","description":"Close a specific open position by crossing the spread.\n\nArgs:\n    request (ClosePositionRequest): Payload containing the exact integer ticket ID.","operationId":"close_position_marketserver_api_trade_close__post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClosePositionRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TradeExecutionResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/marketserver/api/trade/orders/cancel/":{"post":{"tags":["Trade Execution"],"summary":"Cancel Order","description":"Cancel a specific resting pending order from the market.\n\nArgs:\n    request (CancelOrderRequest): Payload containing the exact integer ticket ID of the order to remove.","operationId":"cancel_order_marketserver_api_trade_orders_cancel__post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CancelOrderRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TradeExecutionResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"APIKeyHeader":[]}]}},"/marketserver/api/trade/flatten/":{"post":{"tags":["Trade Execution"],"summary":"Flatten Positions","description":"Emergency Panic Button: Iterates through and closes all open positions.\n\nDesigned for fault tolerance: if one position fails to close (e.g., due to \na sudden requote), the loop catches the exception, logs it, and continues \nattempting to close the remaining positions.","operationId":"flatten_positions_marketserver_api_trade_flatten__post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}},"security":[{"APIKeyHeader":[]}]}},"/marketserver/api/trade/history/":{"get":{"tags":["Trade Execution"],"summary":"Trade History","description":"Retrieve closed trades history and aggregate net performance.\n\nDynamically calculates a rolling lookback window and computes total net \nPnL (Profit + Swap + Commission) across all closed deals.","operationId":"trade_history_marketserver_api_trade_history__get","security":[{"APIKeyHeader":[]}],"parameters":[{"name":"days","in":"query","required":false,"schema":{"type":"integer","description":"Lookback window in days","default":30,"title":"Days"},"description":"Lookback window in days"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TradeHistoryResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/marketserver/api/symbols/all/":{"get":{"tags":["Market Symbols"],"summary":"All Symbols","description":"Retrieve detailed metadata for all available trading symbols.\n\nBrokers frequently group symbols using an internal directory-style path \n(e.g., 'Forex\\Majors\\EURUSD'). This function splits that raw path to \ndynamically infer the asset class and group, allowing the frontend to \nbuild categorized dropdown menus automatically.","operationId":"all_symbols_marketserver_api_symbols_all__get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AllSymbolsResponse"}}}}},"security":[{"APIKeyHeader":[]}]}},"/marketserver/api/calendar/":{"get":{"tags":["Economic Calendar"],"summary":"Economic Calendar","description":"Retrieve and filter upcoming macroeconomic events.\n\nThis function dynamically locates the MT5 data folder (compatible with both \nnative Windows and WINE environments) to read the `calendar_export.csv` file. \nIt normalizes all MQL5 integer timestamps into standard UTC ISO strings.\n\nArgs:\n    importance (str): Comma-separated list of event weights (e.g., '2,3' for High/Med).\n    currency (str): Comma-separated list of target currencies (e.g., 'USD,EUR').\n    \nNote on missing values: MT5 represents empty calendar fields with a specific \nminimum long integer (-9223372036854775808). This function intercepts that \nvalue and safely converts it to Python's `None`.","operationId":"economic_calendar_marketserver_api_calendar__get","security":[{"APIKeyHeader":[]}],"parameters":[{"name":"importance","in":"query","required":false,"schema":{"type":"string","default":"2,3","title":"Importance"}},{"name":"currency","in":"query","required":false,"schema":{"type":"string","default":"USD,EUR,GBP,JPY,AUD,CAD,CHF,NZD","title":"Currency"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CalendarResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/marketserver/api/stat/":{"get":{"tags":["System Statistics"],"summary":"Server Stat","description":"Retrieve comprehensive MetaTrader 5 and physical server statistics.\n\nForensic System Parsing: \nWhen Python runs inside WINE, standard OS metric libraries (like psutil) \nattempt to read Windows APIs that WINE may not fully implement. To bypass \nthis and get true server loads, this function directly parses the underlying \nLinux `/proc` filesystem. Since WINE maps the Linux root to the `Z:/` drive, \nthe router intelligently falls back to `Z:/proc/meminfo` to guarantee accurate \ntelemetry without crashing.","operationId":"server_stat_marketserver_api_stat__get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ServerStatResponse"}}}}},"security":[{"APIKeyHeader":[]}]}}},"components":{"schemas":{"ActiveOrder":{"properties":{"ticket":{"type":"integer","title":"Ticket"},"time_setup":{"type":"integer","title":"Time Setup"},"type":{"type":"integer","title":"Type"},"state":{"type":"integer","title":"State"},"volume_initial":{"type":"number","title":"Volume Initial"},"volume_current":{"type":"number","title":"Volume Current"},"price_open":{"type":"number","title":"Price Open"},"sl":{"type":"number","title":"Sl"},"tp":{"type":"number","title":"Tp"},"price_current":{"type":"number","title":"Price Current"},"symbol":{"type":"string","title":"Symbol"},"comment":{"type":"string","title":"Comment"}},"type":"object","required":["ticket","time_setup","type","state","volume_initial","volume_current","price_open","sl","tp","price_current","symbol","comment"],"title":"ActiveOrder"},"ActiveOrdersResponse":{"properties":{"count":{"type":"integer","title":"Count"},"orders":{"items":{"$ref":"#/components/schemas/ActiveOrder"},"type":"array","title":"Orders"},"timestamp":{"type":"string","title":"Timestamp"}},"type":"object","required":["count","orders","timestamp"],"title":"ActiveOrdersResponse"},"AllSymbolsResponse":{"properties":{"count":{"type":"integer","title":"Count"},"symbols":{"items":{"$ref":"#/components/schemas/SymbolInfo"},"type":"array","title":"Symbols"},"timestamp":{"type":"string","title":"Timestamp"}},"type":"object","required":["count","symbols","timestamp"],"title":"AllSymbolsResponse"},"BookEntry":{"properties":{"type":{"type":"integer","title":"Type"},"price":{"type":"number","title":"Price"},"volume":{"type":"integer","title":"Volume"},"volume_real":{"type":"number","title":"Volume Real"}},"type":"object","required":["type","price","volume","volume_real"],"title":"BookEntry"},"BulkPriceActionResponse":{"properties":{"count_requested":{"type":"integer","title":"Count Requested"},"symbols":{"items":{"type":"string"},"type":"array","title":"Symbols"},"timeframes":{"items":{"type":"string"},"type":"array","title":"Timeframes"},"data":{"additionalProperties":{"additionalProperties":{"items":{"$ref":"#/components/schemas/OHLCV"},"type":"array"},"type":"object"},"type":"object","title":"Data"},"timestamp":{"type":"string","title":"Timestamp"}},"type":"object","required":["count_requested","symbols","timeframes","data","timestamp"],"title":"BulkPriceActionResponse"},"CalendarEvent":{"properties":{"time":{"type":"integer","title":"Time"},"iso_time":{"type":"string","title":"Iso Time"},"event_id":{"type":"string","title":"Event Id"},"event_name":{"type":"string","title":"Event Name"},"currency":{"type":"string","title":"Currency"},"country":{"type":"string","title":"Country"},"importance":{"type":"integer","title":"Importance"},"actual":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Actual"},"forecast":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Forecast"},"previous":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Previous"}},"type":"object","required":["time","iso_time","event_id","event_name","currency","country","importance"],"title":"CalendarEvent"},"CalendarResponse":{"properties":{"count":{"type":"integer","title":"Count"},"events":{"items":{"$ref":"#/components/schemas/CalendarEvent"},"type":"array","title":"Events"},"timestamp":{"type":"string","title":"Timestamp"}},"type":"object","required":["count","events","timestamp"],"title":"CalendarResponse"},"CancelOrderRequest":{"properties":{"ticket":{"type":"integer","title":"Ticket"}},"type":"object","required":["ticket"],"title":"CancelOrderRequest"},"ClosePositionRequest":{"properties":{"ticket":{"type":"integer","title":"Ticket"},"client_timestamp":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Client Timestamp"}},"type":"object","required":["ticket"],"title":"ClosePositionRequest"},"ExecuteTradeRequest":{"properties":{"symbol":{"type":"string","title":"Symbol"},"volume":{"type":"number","title":"Volume"},"type":{"type":"string","title":"Type"},"target_price":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Target Price","default":0.0},"stop_loss":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Stop Loss","default":0.0},"take_profit":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Take Profit","default":0.0},"client_timestamp":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Client Timestamp"}},"type":"object","required":["symbol","volume","type"],"title":"ExecuteTradeRequest"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"MT5Stats":{"properties":{"connected":{"type":"boolean","title":"Connected"},"broker":{"type":"string","title":"Broker"},"server":{"type":"string","title":"Server"},"account_name_initials":{"type":"string","title":"Account Name Initials"},"leverage":{"type":"integer","title":"Leverage"},"ping":{"type":"number","title":"Ping"},"build":{"type":"integer","title":"Build"},"account_currency":{"type":"string","title":"Account Currency"},"balance":{"type":"number","title":"Balance"},"equity":{"type":"number","title":"Equity"},"floating_profit":{"type":"number","title":"Floating Profit"},"margin_free":{"type":"number","title":"Margin Free"},"margin_level_pct":{"type":"number","title":"Margin Level Pct"},"trade_allowed_by_broker":{"type":"boolean","title":"Trade Allowed By Broker"},"algo_trading_allowed":{"type":"boolean","title":"Algo Trading Allowed"},"open_positions_count":{"type":"integer","title":"Open Positions Count"},"pending_o