# MetaTrader 5 Broker Credentials
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# System Configuration
MT5_TIMEZONE=Europe/Athens

# Path to your MT5 executable
# (Linux users: Leave this as-is)
# (Windows users: Update this if your broker installed to a branded folder, e.g., \Pepperstone MetaTrader 5\)
TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe